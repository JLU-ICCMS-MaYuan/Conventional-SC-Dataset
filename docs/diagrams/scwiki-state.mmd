stateDiagram-v2
    [*] --> 用户上传PDF

    state "上传解析管线" as Pipeline {
        用户上传PDF --> 文件已保存: 保存到 data/uploads/
        文件已保存 --> 占位论文入库: 创建 Paper(status=pending)
        占位论文入库 --> 前端显示解析中
        前端显示解析中 --> PDF转纯文本: 文本提取
        PDF转纯文本 --> 提取元数据: LLM 提取标题/DOI/摘要
        提取元数据 --> 更新论文: UPDATE papers
        更新论文 --> 向量化: chunk→embed→Qdrant
        向量化 --> LLM富化: DeepSeek 深度分析全文
        LLM富化 --> 物性写入: INSERT key_properties
        物性写入 --> 解析完成: 富化完成
        PDF转纯文本 --> 解析失败: 管线异常
        提取元数据 --> 解析失败: 管线异常
        LLM富化 --> 解析失败: 管线异常
    }

    解析完成 --> 待审核
    解析失败 --> 已删除: 管理员删除
    解析失败 --> 需修改: 用户删除重试

    state "审核流程" as Review {
        待审核 --> 审核通过: 管理员通过
        待审核 --> 需修改: 管理员退回
        审核通过 --> 审核完成
        审核通过 --> 需修改: 管理员重新打开
        需修改 --> 待审核: 用户修改后重新提交
        需修改 --> 已删除: 管理员删除
        审核完成 --> 需修改: 管理员退回重新审核
    }

    审核完成 --> [*]
    已删除 --> [*]
